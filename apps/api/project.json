{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python manage.py runserver",
        "cwd": "apps/api"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python manage.py migrate",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env\\Scripts\\ruff.exe check .",
        "cwd": "apps/api"
      }
    },
    "format-python": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env\\Scripts\\ruff.exe format .",
        "cwd": "apps/api"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env\\Scripts\\ruff.exe format --check .",
        "cwd": "apps/api"
      }
    },
    "createsuperuser": {
      "executor": "nx:run-commands",
      "options": {
        "command": "env\\Scripts\\python.exe manage.py createsuperuser",
        "cwd": "apps/api"
      }
    }
  }
}